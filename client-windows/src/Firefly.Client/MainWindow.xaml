<Window x:Class="Firefly.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Firefly.Client"
        Title="Firefly — Corner Widget &amp; Flow 2 Prototype"
        Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#D8E1EE">

    <Window.Resources>
        <Style x:Key="SimButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#F2F2F7" BorderBrush="#D1D1D6" BorderThickness="1"
                                CornerRadius="8" Padding="11,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E5EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D1D1D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimErrorButtonStyle" TargetType="Button" BasedOn="{StaticResource SimButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="8" Padding="11,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FEE2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <!-- Top-Left Helper Transcript Chip (from Figma Flow 2) -->
        <Border x:Name="HelperChip" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="White" CornerRadius="18" Padding="16,10" Visibility="Collapsed"
                Panel.ZIndex="5">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HelperChipScale" ScaleX="1.0" ScaleY="1.0" />
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect Color="#1D1B3A" BlurRadius="14" ShadowDepth="3" Opacity="0.14" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Helper: " FontFamily="Segoe UI" FontWeight="Bold" FontSize="15" Foreground="#5856D6" />
                <TextBlock x:Name="HelperTranscriptText" Text="&quot;Click the Print button&quot;"
                           FontFamily="Segoe UI" FontSize="15" Foreground="#1D1B3A" />
            </StackPanel>
        </Border>

        <!-- Simulated App Window ("Print · Grandma's recipe" from Figma Flow 2) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" Width="620" Height="370">
            <Border Background="White" CornerRadius="14" BorderBrush="#E5E5EA" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#1D1B3A" BlurRadius="28" ShadowDepth="8" Opacity="0.14" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Border Grid.Row="0" BorderBrush="#F2F2F7" BorderThickness="0,0,0,1" Padding="18,0">
                        <Grid>
                            <TextBlock Text="Print · Grandma's recipe" FontFamily="Segoe UI" FontWeight="SemiBold"
                                       FontSize="14" Foreground="#1D1D1F" VerticalAlignment="Center" />
                            <TextBlock Text="&#8722;    &#10005;" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Dialog content -->
                    <Grid Grid.Row="1" Margin="22,18,22,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Document preview placeholder -->
                        <Border Grid.Column="0" Background="#EBEDF0" CornerRadius="10" Padding="18">
                            <StackPanel VerticalAlignment="Top">
                                <Border Height="8" Background="#D5D8DC" CornerRadius="4" Margin="0,6,0,10" />
                                <Border Height="8" Background="#D5D8DC" CornerRadius="4" Margin="0,0,0,10" />
                                <Border Height="8" Background="#D5D8DC" CornerRadius="4" Margin="0,0,0,10" />
                                <Border Height="8" Background="#D5D8DC" CornerRadius="4" Margin="0,0,28,10" />
                                <Border Height="8" Background="#D5D8DC" CornerRadius="4" Margin="0,0,48,0" />
                            </StackPanel>
                        </Border>

                        <!-- Print settings form -->
                        <StackPanel Grid.Column="1" Margin="26,8,0,0">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Printer" FontFamily="Segoe UI" FontSize="14" Foreground="#3A3A3C" VerticalAlignment="Center" />
                                <Border Grid.Column="1" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <TextBlock Text="Office Printer" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Foreground="#1D1D1F" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Copies" FontFamily="Segoe UI" FontSize="14" Foreground="#3A3A3C" VerticalAlignment="Center" />
                                <Border Grid.Column="1" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <TextBlock Text="1" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Foreground="#1D1D1F" />
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pages" FontFamily="Segoe UI" FontSize="14" Foreground="#3A3A3C" VerticalAlignment="Center" />
                                <Border Grid.Column="1" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <TextBlock Text="All" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Foreground="#1D1D1F" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Dialog action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                        <Border Background="#F2F2F7" CornerRadius="8" Padding="20,9" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#1D1D1F" />
                        </Border>

                        <!-- Target Button + Reactive Glow Ring + Confirmation Checkmark -->
                        <Grid>
                            <!-- Outer Reactive Glow Ring (Flow 2 Screen 3 & 4) -->
                            <Border x:Name="TargetGlowRing" Visibility="Collapsed"
                                    CornerRadius="14" BorderBrush="#FFD54A" BorderThickness="4"
                                    Margin="-8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD54A" BlurRadius="22" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>

                            <Button x:Name="SimulatedPrintButton" Click="SimScreen5_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#007AFF" CornerRadius="8" Padding="24,9">
                                            <TextBlock x:Name="SimulatedTargetButtonText" Text="{TemplateBinding Content}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                Print
                            </Button>

                            <!-- Green Checkmark Badge (Flow 2 Screen 5) -->
                            <Border x:Name="TargetConfirmedBadge" Visibility="Collapsed"
                                    Width="26" Height="26" CornerRadius="13" Background="#30D158"
                                    BorderBrush="White" BorderThickness="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0">
                                <TextBlock Text="&#10003;" Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Simulated Dotted Mouse Trail (Flow 2 Screen 2-4) -->
            <Canvas x:Name="TrailOverlayCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                <Line X1="145" Y1="245" X2="525" Y2="320"
                      Stroke="#1D1B3A" StrokeThickness="7" StrokeDashArray="0.5 2.3" StrokeDashCap="Round" />
                <Line X1="145" Y1="245" X2="525" Y2="320"
                      Stroke="#FFD54A" StrokeThickness="4.5" StrokeDashArray="0.5 3.8" StrokeDashCap="Round" />
            </Canvas>

            <!-- Simulated On-Target Floating Caption Overlay (Flow 2 Screen 4) -->
            <Border x:Name="FloatingTargetCaptionCard" Visibility="Collapsed"
                    Background="#1D1B3A" CornerRadius="14" Padding="18,14" Width="280"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,75,78">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="FloatingCaptionScale" ScaleX="1.0" ScaleY="1.0" />
                </Border.LayoutTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#1D1B3A" BlurRadius="20" ShadowDepth="6" Opacity="0.32" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="FloatingOverlayTitle" Text="Click Print"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="17" Foreground="White" />
                    <TextBlock x:Name="FloatingOverlayBody"
                               Text="The blue button at the bottom right of this window."
                               FontFamily="Segoe UI" FontSize="14" Foreground="#E5E5EA"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Flow 2 Prototype Simulator Harness Card (Bottom) -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Background="White" CornerRadius="16" Padding="18,14"
                BorderBrush="#E5E5EA" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1D1B3A" BlurRadius="20" ShadowDepth="6" Opacity="0.12" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EEF2FF" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="FLOW 2 PROTOTYPE SIMULATOR" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="11" Foreground="#4F46E5" />
                        </Border>
                        <TextBlock Text="Click the top-right status bubble anytime to expand/hide quick controls (A−/A+/Read aloud/Settings/Stop):"
                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="#3A3A3C"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="SimulatorTelemetryText"
                               Text="State: Idle | Mode: VideoCall | Scale: 1.0x | ReadAloud: Off"
                               FontFamily="Consolas" FontSize="12" Foreground="#4B5563"
                               VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel>
                    <Button Content="1. Location Returned (Gemini JSON)" Style="{StaticResource SimButtonStyle}"
                            Click="SimScreen1_Click" />
                    <Button Content="2. Draw Mouse Path (Follow the trail)" Style="{StaticResource SimButtonStyle}"
                            Click="SimScreen2_Click" />
                    <Button Content="3. Highlight Target (Click glowing button)" Style="{StaticResource SimButtonStyle}"
                            Click="SimScreen3_Click" />
                    <Button Content="4. Text Overlay (Caption Card)" Style="{StaticResource SimButtonStyle}"
                            Click="SimScreen4_Click" />
                    <Button Content="5. Click &amp; Confirm (Done → Step 2)" Style="{StaticResource SimButtonStyle}"
                            Click="SimScreen5_Click" />
                    <Button Content="Error: No Step Returned" Style="{StaticResource SimErrorButtonStyle}"
                            Click="SimNoStepsError_Click" />
                    <Button Content="Error: API Failure" Style="{StaticResource SimErrorButtonStyle}"
                            Click="SimApiError_Click" />
                </WrapPanel>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Simulated API / Event Log: " FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="SimulatorLogText"
                                   Text="Click the top-right Corner Widget pill or choose a Flow 2 screen above."
                                   FontFamily="Consolas" FontSize="12" Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Corner Widget anchored top-right -->
        <local:CornerWidget x:Name="CornerWidgetControl"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Panel.ZIndex="10" />
    </Grid>
</Window>
