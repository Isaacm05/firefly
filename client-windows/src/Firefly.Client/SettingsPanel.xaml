<UserControl x:Class="Firefly.Client.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Segmented button style (used for Text size and Call mode) -->
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5E5CE6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close pill button style matching Figma (78x35, rx=17.5, #F2F2F7 fill, 3px #FFD60A stroke) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F2F2F7" />
            <Setter Property="BorderBrush" Value="#FFD60A" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="17.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color swatch button style matching Figma -->
        <Style x:Key="SwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect Color="#1D1D1F" BlurRadius="6" ShadowDepth="2" Opacity="0.25" />
                            </Grid.Effect>
                            <!-- Outer selection ring (3px stroke #1D1B3A when checked) -->
                            <Ellipse x:Name="Ring" Stroke="#1D1B3A" StrokeThickness="0" Margin="1" />
                            <Ellipse x:Name="Core" Width="28" Height="28" Fill="{TemplateBinding Background}" />
                            <!-- Glossy highlight -->
                            <Ellipse Width="12" Height="10" Fill="White" Opacity="0.4"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,6,0,0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="2.5" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="3" />
                                <Setter TargetName="Core" Property="Width" Value="30" />
                                <Setter TargetName="Core" Property="Height" Value="30" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS style toggle switch (56x32, rx=16, #30D158 when active, white thumb) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="56" Height="32" CornerRadius="16" Background="#E5E5EA">
                            <Border x:Name="Thumb" Width="26" Height="26" CornerRadius="13" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbSlide" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#30D158" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="24" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#E5E5EA" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button style for mockup save -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="12" Padding="32,10" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6D6BF0" Offset="0" />
                                    <GradientStop Color="#4F47C7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="HoverLift" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="ChromeShadow" Color="#2E2B59" BlurRadius="14" ShadowDepth="4" Opacity="0.3" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">
        <Border x:Name="SheetRoot" Width="440" Background="White" CornerRadius="22" Padding="24"
                RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SheetScale" ScaleX="0.94" ScaleY="0.94" />
                    <TranslateTransform x:Name="SheetSlide" Y="16" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#1C1A3B" BlurRadius="36" ShadowDepth="12" Opacity="0.25" />
            </Border.Effect>

            <StackPanel>

                <!-- Header: "Settings" title + "Close" pill button -->
                <DockPanel LastChildFill="False" Margin="0,0,0,18">
                    <TextBlock DockPanel.Dock="Left" Text="Settings" FontFamily="Segoe UI" FontWeight="Bold"
                               FontSize="26" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Width="78" Height="35" Style="{StaticResource CloseButtonStyle}"
                            Content="Close" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#1D1D1F"
                            Click="Close_Click" />
                </DockPanel>

                <!-- Row 1: Text size (136x53 segmented container with Small, Medium, Large 'A') -->
                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Text size" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Right" Width="136" Height="53" Background="#F2F2F7" CornerRadius="10" Padding="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton x:Name="TextSizeSmallRadio" GroupName="TextSize" Tag="Small" FontSize="14"
                                         Style="{StaticResource SegmentButtonStyle}"
                                         Width="40" Height="45"
                                         Checked="TextSizeChanged" Content="A" />
                            <RadioButton x:Name="TextSizeMediumRadio" GroupName="TextSize" Tag="Medium" FontSize="18" Margin="4,0,0,0"
                                         Style="{StaticResource SegmentButtonStyle}"
                                         Width="40" Height="45"
                                         Checked="TextSizeChanged" Content="A" />
                            <RadioButton x:Name="TextSizeLargeRadio" GroupName="TextSize" Tag="Large" FontSize="24" Margin="4,0,0,0" IsChecked="True"
                                         Style="{StaticResource SegmentButtonStyle}"
                                         Width="40" Height="45"
                                         Checked="TextSizeChanged" Content="A" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Row 2: Highlight color (Yellow #FFD60A, Blue #64D2FF, Pink #FF6FB5) -->
                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Highlight color" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="HighlightYellowRadio" GroupName="HighlightColor" Tag="Yellow" Background="#FFD60A" IsChecked="True"
                                     Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                        <RadioButton x:Name="HighlightBlueRadio" GroupName="HighlightColor" Tag="Blue" Background="#64D2FF" Margin="10,0,0,0"
                                     Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                        <RadioButton x:Name="HighlightPinkRadio" GroupName="HighlightColor" Tag="Pink" Background="#FF6FB5" Margin="10,0,0,0"
                                     Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                    </StackPanel>
                </DockPanel>

                <!-- Row 3: Read instructions out loud (Toggle switch) -->
                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Read instructions out loud" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <ToggleButton x:Name="ReadAloudToggle" DockPanel.Dock="Right" IsChecked="True"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ReadAloudToggled" Unchecked="ReadAloudToggled" />
                </DockPanel>

                <!-- Row 4: Show text captions (Toggle switch) -->
                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Show text captions" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <ToggleButton x:Name="CaptionsToggle" DockPanel.Dock="Right" IsChecked="True"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="CaptionsToggled" Unchecked="CaptionsToggled" />
                </DockPanel>

                <!-- Row 4b: Visible in screen recordings (off by default, NFR-03) -->
                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Visible in screen recordings" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <ToggleButton x:Name="CaptureVisibleToggle" DockPanel.Dock="Right" IsChecked="False"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="CaptureVisibleToggled" Unchecked="CaptureVisibleToggled" />
                </DockPanel>

                <!-- Row 5: Talk to your helper (157x43 segmented container: "Video" / "Phone") -->
                <DockPanel LastChildFill="False" Margin="0,0,0,18">
                    <TextBlock DockPanel.Dock="Left" Text="Talk to your helper" FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Right" Width="157" Height="43" Background="#F2F2F7" CornerRadius="10" Padding="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton x:Name="CallModeVideoRadio" GroupName="CallMode" Tag="VideoCall" IsChecked="True"
                                         Style="{StaticResource SegmentButtonStyle}"
                                         Width="72" Height="35"
                                         Checked="CallModeChanged" Content="Video" />
                            <RadioButton x:Name="CallModePhoneRadio" GroupName="CallMode" Tag="PhoneSpeaker"
                                         Style="{StaticResource SegmentButtonStyle}"
                                         Width="72" Height="35"
                                         Checked="CallModeChanged" Content="Phone" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Live preview banner -->
                <Border Background="#1D1B3A" CornerRadius="16" Padding="16,12" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="PreviewDot" Width="14" Height="14" Fill="#FFD60A" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewText" Text='Preview: Click "Print"' FontFamily="Segoe UI"
                                   FontWeight="Bold" FontSize="24" Foreground="#FFD60A" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Mockup Save button and toast -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="SaveClicked" />
                    <TextBlock x:Name="SavedToast" DockPanel.Dock="Left" Text="Settings saved" Foreground="#30D158" FontFamily="Segoe UI"
                               FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0"
                               Visibility="Collapsed" />
                </DockPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>