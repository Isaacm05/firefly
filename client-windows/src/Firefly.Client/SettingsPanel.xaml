<UserControl x:Class="Firefly.Client.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="620">

    <UserControl.Resources>

        <!-- ponytail: Inter isn't a Windows system font; Segoe UI is the closest built-in match.
             Bundle Inter via PackageReference/embedded resource if exact typography matters later. -->

        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="16,8" Background="#005E5CE6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#5E5CE6" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#005E5CE6" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect Color="#1D1D1F" BlurRadius="6" ShadowDepth="2" Opacity="0.25" />
                            </Grid.Effect>
                            <Ellipse x:Name="Ring" Stroke="#1D1D1F" StrokeThickness="0" />
                            <Ellipse Width="32" Height="32" Fill="{TemplateBinding Background}" />
                            <!-- glossy highlight: a fixed light spot reads as a lit sphere on any hue -->
                            <Ellipse Width="14" Height="13" Fill="White" Opacity="0.4"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,6,0,0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="3" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="StrokeThickness"
                                                             To="3" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="StrokeThickness"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.14" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.14" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="56" Height="32" CornerRadius="16" Background="#C7C7CC">
                            <Border x:Name="Thumb" Width="26" Height="26" CornerRadius="13" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbSlide" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#30D158" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="24" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#C7C7CC" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="14" Padding="40,14" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6D6BF0" Offset="0" />
                                    <GradientStop Color="#4F47C7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="HoverLift" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="ChromeShadow" Color="#2E2B59" BlurRadius="16" ShadowDepth="6" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="ShadowDepth" To="9" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="BlurRadius" To="16" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeShadow" Storyboard.TargetProperty="ShadowDepth" To="6" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border x:Name="SheetRoot" Background="White" CornerRadius="24" Padding="32" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="SheetScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="SheetSlide" Y="16" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#1C1A3B" BlurRadius="50" ShadowDepth="14" Opacity="0.28" />
        </Border.Effect>

        <StackPanel>

            <!-- Header -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFCB8A" Offset="0" />
                            <GradientStop Color="#FF9A42" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#B36A1F" BlurRadius="10" ShadowDepth="3" Opacity="0.35" />
                    </Border.Effect>
                    <TextBlock Text="&#x1F505;" FontFamily="Segoe UI Emoji" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="Make it comfortable" FontFamily="Segoe UI" FontWeight="Black"
                           FontSize="30" Foreground="#1D1D1F" VerticalAlignment="Center" Margin="14,0,0,0" />
            </DockPanel>

            <!-- Call mode -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Left" Text="How do you talk to your helper?" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="#F2F2F7" CornerRadius="10" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="CallMode" Tag="VideoCall" IsChecked="True"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Checked="CallModeChanged" Content="Video call" />
                        <RadioButton GroupName="CallMode" Tag="PhoneSpeaker"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Checked="CallModeChanged" Content="Phone on speaker" Margin="2,0,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Text size -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Left" Text="Text size" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="#F2F2F7" CornerRadius="10" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="TextSize" Tag="Small" FontSize="14"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Checked="TextSizeChanged" Content="A" />
                        <RadioButton GroupName="TextSize" Tag="Medium" FontSize="18" Margin="2,0,0,0"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Checked="TextSizeChanged" Content="A" />
                        <RadioButton GroupName="TextSize" Tag="Large" FontSize="24" Margin="2,0,0,0" IsChecked="True"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Checked="TextSizeChanged" Content="A" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Highlight color -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Left" Text="Highlight color" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton GroupName="HighlightColor" Tag="Yellow" Background="#FFD60A" IsChecked="True"
                                 Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                    <RadioButton GroupName="HighlightColor" Tag="Blue" Background="#5AC8FA" Margin="10,0,0,0"
                                 Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                    <RadioButton GroupName="HighlightColor" Tag="Pink" Background="#FF375F" Margin="10,0,0,0"
                                 Style="{StaticResource SwatchStyle}" Checked="HighlightColorChanged" />
                </StackPanel>
            </DockPanel>

            <!-- Read aloud -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Left" Text="Read instructions out loud" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <ToggleButton x:Name="ReadAloudToggle" DockPanel.Dock="Right" IsChecked="True"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="ReadAloudToggled" Unchecked="ReadAloudToggled" />
            </DockPanel>

            <!-- Captions -->
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Left" Text="Show text captions" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="18" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <ToggleButton x:Name="CaptionsToggle" DockPanel.Dock="Right" IsChecked="True"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="CaptionsToggled" Unchecked="CaptionsToggled" />
            </DockPanel>

            <!-- Live preview -->
            <Border Background="#1D1B3A" CornerRadius="999" Padding="16,12" HorizontalAlignment="Left" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PreviewDot" Width="14" Height="14" Fill="#FFD60A" VerticalAlignment="Center" />
                    <TextBlock x:Name="PreviewText" Text='Preview: Click &quot;Print&quot;' FontFamily="Segoe UI"
                               FontWeight="Bold" FontSize="24" Foreground="White" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Save -->
            <Grid Margin="0">
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                        Click="SaveClicked" />
                <TextBlock x:Name="SavedToast" Text="Settings saved" Foreground="#1D1D1F" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="200,0,0,0"
                           Visibility="Collapsed" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
